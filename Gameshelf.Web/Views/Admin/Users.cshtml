@model IEnumerable<GameShelf.Web.Controllers.UserViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="container">
    <h1 class="gs-page-title">User Management</h1>
    <p class="gs-page-subtitle">View and manage all users</p>

    @if (TempData["RoleEditSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["RoleEditSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Username</th>
                    <th>Roles</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>@user.UserName</td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge bg-primary me-1">@role</span>
                            }
                        </td>
                        <td>
                            <a asp-action="EditRoles" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Edit roles</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a asp-action="Index" class="gs-back-link">← Back to Dashboard</a>
</div>
