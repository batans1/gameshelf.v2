@{
    ViewData["Title"] = "Privacy";
}

<div class="container">
    <h1 class="gs-page-title">Privacy</h1>
    <p class="gs-page-subtitle">How GameShelf handles your data.</p>

    <div class="card">
        <div class="card-body">
            <h5>Account Data</h5>
            <p class="mb-3">We store your account details, ratings, reviews, and savings cart items so core features can work.</p>

            <h5>Moderation</h5>
            <p class="mb-3">Written reviews are moderated for profanity. Violations may trigger warnings and temporary posting timeouts.</p>

            <h5>Analytics</h5>
            <p class="mb-0">We store deal click events to help platform owners understand engagement.</p>
        </div>
    </div>
</div>
