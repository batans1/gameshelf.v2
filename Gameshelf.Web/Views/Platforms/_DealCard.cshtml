@model GameShelf.Models.ViewModels.LiveDeals.LiveDealDto
@{
    var hasValidDealId = !string.IsNullOrEmpty(Model.DealId);
    var customDealId = Model.CustomDealId;
    var buyNow = Model.BuyNowPercent;
    var wait = Model.WaitPercent;
    var notWorthIt = Model.NotWorthItPercent;
    var verdictClass = "";
    if (buyNow > 0 || wait > 0 || notWorthIt > 0)
    {
        if (buyNow >= wait && buyNow >= notWorthIt) verdictClass = "deal-card-verdict-buynow";
        else if (wait >= notWorthIt) verdictClass = "deal-card-verdict-wait";
        else verdictClass = "deal-card-verdict-notworthit";
    }
}
<div class="col">
    <div class="card deal-card h-100 @verdictClass">
        @if (hasValidDealId || customDealId.HasValue)
        {
            <a asp-controller="Platforms" asp-action="GameDetails" 
               asp-route-dealId="@(hasValidDealId ? Model.DealId : null)" 
               asp-route-storeName="@Model.StoreName" 
               asp-route-customDealId="@(customDealId?.ToString() ?? null)"
               class="text-decoration-none text-dark">
                <div class="card-img-top d-flex align-items-center justify-content-center" style="overflow: hidden;">
                    @if (!string.IsNullOrEmpty(Model.ThumbUrl))
                    {
                        <img src="@Model.ThumbUrl" alt="@Model.Title" class="img-fluid" style="object-fit: contain; max-height: 100%;" loading="lazy" />
                    }
                    else
                    {
                        <span class="text-white-50">No image</span>
                    }
                </div>
                <div class="card-body d-flex flex-column">
                    @if (!string.IsNullOrEmpty(Model.StoreName))
                    {
                        <span class="badge bg-secondary mb-1">@Model.StoreName</span>
                    }
                    <h6 class="card-title">@Model.Title</h6>
                    @if (hasValidDealId || customDealId.HasValue)
                    {
                        <div class="verdict-indicator-small mb-2">
                            <small class="text-muted">
                                <a asp-controller="Platforms" asp-action="GameDetails" 
                                   asp-route-dealId="@(hasValidDealId ? Model.DealId : null)" 
                                   asp-route-storeName="@Model.StoreName"
                                   asp-route-customDealId="@(customDealId?.ToString() ?? null)"
                                   class="text-decoration-none">
                                    💭 See community verdict →
                                </a>
                            </small>
                        </div>
                    }
                    <div class="mt-auto pt-2">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="text-success fw-bold">€@Model.SalePriceEur.ToString("F2")</span>
                            <span class="text-muted small">$@Model.SalePriceUsd.ToString("F2")</span>
                        </div>
                        @if (Model.NormalPriceUsd > Model.SalePriceUsd)
                        {
                            <div class="small text-muted">
                                <s>€@Model.NormalPriceEur.ToString("F2")</s> <s>$@Model.NormalPriceUsd.ToString("F2")</s>
                                <span class="badge bg-success ms-1">@Model.SavingsPercent.ToString("F0")% off</span>
                            </div>
                        }
                    </div>
                </div>
            </a>
        }
        else
        {
        <a href="@Model.DealUrl" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-dark">
            <div class="card-img-top d-flex align-items-center justify-content-center" style="overflow: hidden;">
                @if (!string.IsNullOrEmpty(Model.ThumbUrl))
                {
                    <img src="@Model.ThumbUrl" alt="@Model.Title" class="img-fluid" style="object-fit: contain; max-height: 100%;" loading="lazy" />
                }
                else
                {
                    <span class="text-white-50">No image</span>
                }
            </div>
            <div class="card-body d-flex flex-column">
                @if (!string.IsNullOrEmpty(Model.StoreName))
                {
                    <span class="badge bg-secondary mb-1">@Model.StoreName</span>
                }
                <h6 class="card-title">@Model.Title</h6>
                <div class="mt-auto pt-2">
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span class="text-success fw-bold">€@Model.SalePriceEur.ToString("F2")</span>
                        <span class="text-muted small">$@Model.SalePriceUsd.ToString("F2")</span>
                    </div>
                    @if (Model.NormalPriceUsd > Model.SalePriceUsd)
                    {
                        <div class="small text-muted">
                            <s>€@Model.NormalPriceEur.ToString("F2")</s> <s>$@Model.NormalPriceUsd.ToString("F2")</s>
                            <span class="badge bg-success ms-1">@Model.SavingsPercent.ToString("F0")% off</span>
                        </div>
                    }
                </div>
            </div>
        </a>
        }
        <div class="card-footer bg-transparent border-0 pt-0">
            <a href="@(string.IsNullOrEmpty(Model.DealUrl) ? "#" : Model.DealUrl)" target="_blank" rel="noopener noreferrer"
               class="btn btn-sm btn-primary w-100 view-deal-btn"
               data-deal-id="@(Model.DealId ?? "")"
               data-custom-deal-id="@(Model.CustomDealId?.ToString() ?? "")"
               data-store-name="@(Model.StoreName ?? "")"
               data-game-title="@(Model.Title ?? "")"
               data-deal-url="@(string.IsNullOrEmpty(Model.DealUrl) ? "#" : Model.DealUrl)">View deal</a>
        </div>
    </div>
</div>
