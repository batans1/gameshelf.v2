@model GameShelf.Models.ViewModels.Platforms.PlatformViewModel
@{
    ViewData["Title"] = "Delete Platform";
}

<h1>Delete Platform</h1>
<h3>Are you sure you want to delete @Model.Name?</h3>
<div class="mt-4">
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.Name)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.WebsiteUrl)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.WebsiteUrl)</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
