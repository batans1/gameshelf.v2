@model IEnumerable<GameShelf.Models.ViewModels.Platforms.DealClickViewModel>
@{
    ViewData["Title"] = "Deal Click Statistics";
    var platformName = ViewData["PlatformName"] as string ?? "Platform";
}

<h1 class="gs-page-title">Deal Click Statistics - @platformName</h1>
<p class="gs-page-subtitle">View how many times users clicked "View deal" for each game on your platform.</p>

@if (!Model.Any())
{
    <div class="gs-empty-state">
        <div class="gs-empty-icon">📊</div>
        <h5>No clicks recorded yet</h5>
        <p class="text-muted mb-0">Clicks will appear here once users start clicking "View deal" buttons.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Game Title</th>
                    <th>Click Count</th>
                    <th>Last Clicked</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var click in Model)
                {
                    <tr>
                        <td>
                            <strong>@click.GameTitle</strong>
                            <br>
                            <small class="text-muted">Deal ID: @click.DealId</small>
                        </td>
                        <td>
                            <span class="badge bg-primary">@click.ClickCount</span>
                        </td>
                        <td>
                            @if (click.LastClickedAt.HasValue)
                            {
                                var localTime = click.LastClickedAt.Value.ToLocalTime();
                                <time datetime="@localTime.ToString("O")">
                                    @localTime.ToString("g")
                                </time>
                            }
                            else
                            {
                                <span class="text-muted">Never</span>
                            }
                        </td>
                        <td>
                            <a href="@click.DealUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                View Deal
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Manage" class="gs-back-link">← Back to My Platforms</a>
