@model IEnumerable<GameShelf.Models.ViewModels.Platforms.PlatformViewModel>
@{
    ViewData["Title"] = "My Platforms";
}

<h1>My Platforms</h1>
<p class="text-muted">Platforms you manage</p>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Platform</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Name)</th>
            <th>@Html.DisplayNameFor(m => m.WebsiteUrl)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td><a href="@item.WebsiteUrl" target="_blank" rel="noopener">@item.WebsiteUrl</a></td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Deals" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View Deals</a>
                    <a asp-action="CustomDeals" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">Custom Deals</a>
                    <a asp-action="ClickStats" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">Click Stats</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
