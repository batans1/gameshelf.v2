@model GameShelf.Models.ViewModels.Profile.PublicProfileViewModel
@{
    ViewData["Title"] = $"{Model.UserName} - Public Profile";
    var includeNoText = (bool?)ViewData["IncludeNoText"] == true;
}

<div class="container">
    <div class="card mb-4">
        <div class="card-body d-flex align-items-center gap-3">
            <img src="@Model.AvatarUrl" alt="@Model.UserName avatar" class="profile-avatar" />
            <div>
                <h1 class="gs-page-title mb-1">@Model.UserName</h1>
                <div class="text-muted">Reviews left: @Model.TextReviewsCount (Text) / @Model.TotalRatings (All ratings)</div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Reviews</h2>
        <a class="btn btn-outline-secondary btn-sm"
           asp-action="Public"
           asp-route-username="@Model.UserName"
           asp-route-includeNoText="@(!includeNoText)">
            @(includeNoText ? "Show text-only reviews" : "Show all ratings")
        </a>
    </div>

    @if (!Model.Reviews.Any())
    {
        <div class="gs-empty-state">
            <p class="mb-0 text-muted">No reviews available.</p>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var review in Model.Reviews)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between">
                        <strong>@review.ReasonText</strong>
                        <small class="text-muted">@review.CreatedAt.ToLocalTime().ToString("g")</small>
                    </div>
                    <div class="text-muted small">Verdict: @review.Verdict</div>
                    <p class="mb-0 mt-2">@(string.IsNullOrWhiteSpace(review.ReviewText) ? "(No written text)" : review.ReviewText)</p>
                </div>
            }
        </div>
    }
</div>
