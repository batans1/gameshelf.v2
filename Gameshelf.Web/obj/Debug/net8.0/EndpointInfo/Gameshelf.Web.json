    "/api/platforms": {
      "get": {
        "tags": [
          "PlatformsApi"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlatformViewModel"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "PlatformsApi"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "Name",
                  "WebsiteUrl"
                ],
                "type": "object",
                "properties": {
                  "Name": {
                    "maxLength": 100,
                    "minLength": 2,
                    "type": "string"
                  },
                  "WebsiteUrl": {
                    "maxLength": 500,
                    "minLength": 5,
                    "type": "string",
                    "format": "uri"
                  },
                  "SupportUrl": {
                    "maxLength": 500,
                    "type": "string",
                    "format": "uri"
                  },
                  "Images": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  },
                  "MainImageIndex": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "ExistingImages": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/PlatformImageViewModel"
                    }
                  },
                  "SelectedOwnerIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "AvailableOwners": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/SelectListItem"
                    }
                  }
                }
              },
              "encoding": {
                "Name": {
                  "style": "form"
                },
                "WebsiteUrl": {
                  "style": "form"
                },
                "SupportUrl": {
                  "style": "form"
                },
                "Images": {
                  "style": "form"
                },
                "MainImageIndex": {
                  "style": "form"
                },
                "ExistingImages": {
                  "style": "form"
                },
                "SelectedOwnerIds": {
                  "style": "form"
                },
                "AvailableOwners": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformViewModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
